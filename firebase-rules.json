{
    "rules": {
        "allowedUsers": {
            ".read": "auth != null",
            ".write": false,
            "$uid": {
                ".validate": "newData.isBoolean()"
            }
        },
        "users": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid && root.child('allowedUsers').child(auth.uid).val() === true",
                ".write": "auth != null && auth.uid == $uid && root.child('allowedUsers').child(auth.uid).val() === true",
                "expenses": {
                    "$expenseId": {
                        ".validate": "newData.hasChildren(['userId', 'amount', 'currency', 'description', 'tag', 'timestamp', 'dateStr', 'timeStr'])",
                        "userId": {
                            ".validate": "newData.isString() && newData.val() == $uid"
                        },
                        "amount": {
                            ".validate": "newData.isNumber() && newData.val() >= 0"
                        },
                        "currency": {
                            ".validate": "newData.isString() && newData.val().length > 0"
                        },
                        "amountINR": {
                            ".validate": "newData.isNumber() && newData.val() >= 0"
                        },
                        "amountUSD": {
                            ".validate": "newData.isNumber() && newData.val() >= 0"
                        },
                        "description": {
                            ".validate": "newData.isString()"
                        },
                        "tag": {
                            ".validate": "newData.isString() && newData.val().length > 0"
                        },
                        "timestamp": {
                            ".validate": "newData.isNumber() && newData.val() > 0"
                        },
                        "dateStr": {
                            ".validate": "newData.isString()"
                        },
                        "timeStr": {
                            ".validate": "newData.isString()"
                        },
                        "type": {
                            ".validate": "newData.val() == 'debit' || newData.val() == 'credit'"
                        },
                        "tripId": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
                        },
                        "hasReceipt": {
                            ".validate": "newData.isBoolean()"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "preferences": {
                    ".validate": "newData.hasChildren()",
                    "currency": {
                        ".validate": "newData.isString() && newData.val().length > 0"
                    },
                    "exportUrl": {
                        ".validate": "newData.isString()"
                    },
                    "statsCurrency": {
                        ".validate": "newData.isString() && newData.val().length > 0"
                    },
                    "gmailSync": {
                        ".validate": "newData.hasChildren(['enabled', 'autoSyncFrequency'])",
                        "enabled": {
                            ".validate": "newData.isBoolean()"
                        },
                        "autoSyncFrequency": {
                            ".validate": "newData.val() == 'manual' || newData.val() == 'daily' || newData.val() == 'weekly'"
                        },
                        "lastSyncTimestamp": {
                            ".validate": "newData.val() == null || newData.isNumber()"
                        },
                        "syncDateRange": {
                            ".validate": "newData.isNumber()"
                        },
                        "transactionTypeFilter": {
                            ".validate": "newData.val() == 'debit' || newData.val() == 'credit' || newData.val() == 'both'"
                        },
                        "ignoredEmailIds": {
                            ".validate": "true"
                        }
                    },
                    "budgets": {
                        ".validate": "newData.hasChildren(['currency'])",
                        "currency": {
                            ".validate": "newData.isString() && newData.val().length == 3"
                        },
                        "total": {
                            ".validate": "newData.isNumber() && newData.val() >= 0"
                        },
                        "tags": {
                            "$i": {
                                ".validate": "newData.hasChildren(['tag', 'amount'])",
                                "tag": {
                                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
                                },
                                "amount": {
                                    ".validate": "newData.isNumber() && newData.val() >= 0"
                                },
                                "$other": {
                                    ".validate": false
                                }
                            }
                        },
                        "$other": {
                            ".validate": false
                        }
                    },
                    "trips": {
                        "$tripId": {
                            ".validate": "$tripId.length <= 40 && newData.hasChildren(['name', 'startDate', 'endDate', 'currency'])",
                            "name": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
                            },
                            "startDate": {
                                ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)"
                            },
                            "endDate": {
                                ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && newData.val() >= newData.parent().child('startDate').val()"
                            },
                            "currency": {
                                ".validate": "newData.isString() && newData.val().length == 3"
                            },
                            "budget": {
                                ".validate": "newData.isNumber() && newData.val() >= 0"
                            },
                            "$other": {
                                ".validate": false
                            }
                        }
                    },
                    "smsInboxToken": {
                        ".validate": "newData.isString() && newData.val().length >= 32"
                    },
                    "$other": {
                        ".validate": false
                    }
                },
                "recurring": {
                    "$ruleId": {
                        ".validate": "newData.hasChildren(['description', 'amount', 'currency', 'tag', 'dayOfMonth', 'startMonth', 'active'])",
                        "description": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                        },
                        "amount": {
                            ".validate": "newData.isNumber() && newData.val() > 0"
                        },
                        "currency": {
                            ".validate": "newData.isString() && newData.val().length == 3"
                        },
                        "tag": {
                            ".validate": "newData.isString() && newData.val().length > 0"
                        },
                        "dayOfMonth": {
                            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
                        },
                        "startMonth": {
                            ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]$/)"
                        },
                        "lastGenerated": {
                            ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]$/)"
                        },
                        "active": {
                            ".validate": "newData.isBoolean()"
                        },
                        "createdAt": {
                            ".validate": "newData.isNumber()"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "receipts": {
                    "$expenseId": {
                        ".validate": "newData.hasChildren(['data'])",
                        "data": {
                            ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 600000"
                        },
                        "createdAt": {
                            ".validate": "newData.isNumber()"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                }
            }
        },
        "donationExclusions": {
            ".read": "auth != null",
            ".write": false,
            "$uid": {
                ".validate": "newData.isBoolean()"
            }
        },
        "smsInboxTokens": {
            "$token": {
                ".write": "auth != null && root.child('allowedUsers').child(auth.uid).val() === true && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)",
                ".validate": "$token.length >= 32 && $token.length <= 64"
            }
        },
        "smsInbox": {
            "$token": {
                ".read": "auth != null && root.child('smsInboxTokens').child($token).val() === auth.uid",
                "$msgId": {
                    ".write": "root.child('smsInboxTokens').child($token).exists() && ((!data.exists() && newData.exists()) || (!newData.exists() && auth != null && root.child('smsInboxTokens').child($token).val() === auth.uid))",
                    ".validate": "newData.hasChildren(['text'])",
                    "text": {
                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
                    },
                    "$other": {
                        ".validate": false
                    }
                }
            }
        }
    }
}
